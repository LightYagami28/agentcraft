{
  "name": "agentcraft-foreman",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "AgentCraft Foreman: multi-agent orchestrator (Claude Agent SDK) that the Minecraft mod renders.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "tui": "node --import tsx scripts/fake-mod.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts",
    "check:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts --check",
    "check": "tsc --noEmit && vitest run && node --import tsx scripts/gen-protocol-doc.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
